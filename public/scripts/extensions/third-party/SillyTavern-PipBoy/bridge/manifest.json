{
    "manifest_version": 3,
    "name": "Pip-Boy 3000 Bridge",
    "version": "0.3.0",
    "description": "Claude ↔ SillyTavern bridge with UI pipeline indicator",

    "browser_specific_settings": {
        "gecko": {
            "id": "pipboy-bridge@sillytavern.local",
            "strict_min_version": "142.0",
            "data_collection_permissions": {
                "required": ["none"]
            }
        }
    },

    "permissions": [
        "storage",
        "tabs"
    ],

    "host_permissions": [
        "https://claude.ai/*",
        "https://*.claude.ai/*",
        "http://localhost/*",
        "http://127.0.0.1/*"
    ],

    "background": {
        "service_worker": "background.js",
        "scripts": ["browser-api.js", "background.js"]
    },

    "content_scripts": [
        {
            "matches": [
                "https://claude.ai/*",
                "https://*.claude.ai/*"
            ],
            "js": ["browser-api.js", "content-claude.js"],
            "run_at": "document_idle"
        },
        {
            "matches": [
                "http://localhost/*",
                "http://127.0.0.1/*"
            ],
            "js": ["browser-api.js", "content-st.js"],
            "run_at": "document_idle"
        }
    ],

    "web_accessible_resources": [{
        "resources": ["bridge-ui.js", "icon_vault_mascot.svg"],
        "matches": ["<all_urls>"]
    }],

    "options_ui": {
        "page": "options.html",
        "open_in_tab": true
    },

    "action": {
        "default_title": "Pip-Boy 3000 Bridge",
        "default_icon": "icon_vault_mascot.svg"
    }
}
